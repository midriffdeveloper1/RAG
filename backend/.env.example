# -----------------------------------------------------------------------------
# App
# -----------------------------------------------------------------------------
APP_NAME="AI Support Agent"
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1

# CORS - comma separated list of allowed origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# -----------------------------------------------------------------------------
# Postgres
# -----------------------------------------------------------------------------
POSTGRES_USER=support_agent
POSTGRES_PASSWORD=change_me
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=support_agent_db
# Full URL is assembled from the above at runtime, or override directly:
# DATABASE_URL=postgresql://support_agent:change_me@localhost:5432/support_agent_db

# -----------------------------------------------------------------------------
# Qdrant (vector store) - fill in when implementing RAG
# -----------------------------------------------------------------------------
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION_NAME=business_knowledge_base
# QDRANT_API_KEY=  # only needed for Qdrant Cloud

# -----------------------------------------------------------------------------
# LLM provider - fill in when implementing RAG
# -----------------------------------------------------------------------------
# ANTHROPIC_API_KEY=
# EMBEDDING_MODEL=text-embedding-3-small
