APP_NAME="AI Support Agent"
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1

# CORS - comma separated list of allowed origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

POSTGRES_USER=postgres
POSTGRES_PASSWORD=kmalldigallhamadamji
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=support_agent


SECRET_KEY=dev-secret-key-change-me-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

ADMIN_EMAIL=admin@rag.example
ADMIN_PASSWORD=Fake@12312
ADMIN_SEED_FORCE_UPDATE=false

UPLOAD_DIR=app/uploads
MAX_UPLOAD_SIZE_MB=20
ALLOWED_UPLOAD_EXTENSIONS=.pdf,.docx,.doc

CHUNK_SIZE=500
CHUNK_OVERLAP=120
RETRIEVAL_CANDIDATE_MULTIPLIER=4
KEYWORD_BOOST_WEIGHT=0.25
MAX_HISTORY_EXCHANGES=3

CANCELLATION_WINDOW_HOURS=24
SLOT_STEP_MINUTES=30
BOOKING_WINDOW_DAYS=30
MAX_TOOL_ITERATIONS=4

EMBEDDING_MODEL_NAME=sentence-transformers/multi-qa-MiniLM-L6-cos-v1
EMBEDDING_DIMENSION=384
EMBEDDING_BATCH_SIZE=32

RETRIEVAL_TOP_K=5
RELEVANCE_SCORE_THRESHOLD=0.1

GROQ_API_KEY=your_api_key
GROQ_MODEL=llama-3.1-8b-instant
GROQ_TEMPERATURE=0.3
GROQ_MAX_TOKENS=400

BUSINESS_NAME="Serenity Salon & Spa"
BUSINESS_DESCRIPTION="full-service beauty salon and spa"



# Voice (Deepgram STT + TTS)
DEEPGRAM_API_KEY=your_deepgram_api_key
DEEPGRAM_PROJECT_ID=your_deepgram_project_id
VOICE_TOKEN_TTL_SECONDS=60
VOICE_MAX_CALL_SECONDS=900


OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OPENROUTER_FAST_MODEL=

OPENAI_API_KEY=your_openai_api_key
