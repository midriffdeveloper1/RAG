# -----------------------------------------------------------------------------
# App
# -----------------------------------------------------------------------------
APP_NAME="AI Support Agent"
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1

# CORS - comma separated list of allowed origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# -----------------------------------------------------------------------------
# Postgres
# -----------------------------------------------------------------------------
POSTGRES_USER=support_agent
POSTGRES_PASSWORD=change_me
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=support_agent_db
# Full URL is assembled from the above at runtime, or override directly:
# DATABASE_URL=postgresql://support_agent:change_me@localhost:5432/support_agent_db

# -----------------------------------------------------------------------------
# Qdrant (vector store)
# -----------------------------------------------------------------------------
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION_NAME=business_knowledge_base
# QDRANT_API_KEY=  # only needed for Qdrant Cloud

# -----------------------------------------------------------------------------
# Auth (JWT) - generate a real secret with: openssl rand -hex 32
# -----------------------------------------------------------------------------
SECRET_KEY=dev-secret-key-change-me-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# -----------------------------------------------------------------------------
# Seeded admin account (login-only, no signup endpoint exists)
# -----------------------------------------------------------------------------
ADMIN_EMAIL=admin@serenitysalon.example
ADMIN_PASSWORD=change_me_now
# Set to true for ONE restart to rotate the password, then set back to false.
ADMIN_SEED_FORCE_UPDATE=false

# -----------------------------------------------------------------------------
# Document upload / ingestion
# -----------------------------------------------------------------------------
UPLOAD_DIR=app/uploads
MAX_UPLOAD_SIZE_MB=20
ALLOWED_UPLOAD_EXTENSIONS=.pdf,.docx,.doc

# --- Chunking ---
CHUNK_SIZE=800
CHUNK_OVERLAP=120

# --- Embeddings (local model, no API key required) ---
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384
EMBEDDING_BATCH_SIZE=32

# -----------------------------------------------------------------------------
# Retrieval
# -----------------------------------------------------------------------------
RETRIEVAL_TOP_K=5
# Cosine similarity (0-1). Below this, a question is treated as
# out-of-domain and answered with a polite refusal instead of calling the
# LLM. Lower = more permissive, higher = stricter. See docs/RAG_PIPELINE.md.
RELEVANCE_SCORE_THRESHOLD=0.35

# -----------------------------------------------------------------------------
# LLM (Groq) — get a free key at https://console.groq.com/keys
# -----------------------------------------------------------------------------
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
GROQ_TEMPERATURE=0.3
GROQ_MAX_TOKENS=600

# -----------------------------------------------------------------------------
# Business identity (used in the assistant's system prompt)
# -----------------------------------------------------------------------------
BUSINESS_NAME=AI Support Agent
BUSINESS_DESCRIPTION=boutique hair, beauty, and wellness salon
